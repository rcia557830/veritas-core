erDiagram
    %% One diagram. Solid = database FK; dotted = application-level reference only.
    %% Composite FK column pairs are listed in the child entities and explained in the companion document.
    roles {
        bigint id PK
        string name
        string slug
    }
    permissions {
        bigint id PK
        string name
    }
    permission_role {
        bigint permission_id PK, FK
        bigint role_id PK, FK
    }
    users {
        bigint id PK
        bigint role_id FK "nullable"
        string email
        string status
    }
    clients {
        bigint id PK
        bigint created_by FK
        bigint assigned_to FK "nullable"
        bigint onboarded_by FK "nullable"
        string client_code
        string status
        datetime onboarded_at "nullable"
    }
    documents {
        bigint id PK
        bigint client_id FK
        bigint uploaded_by FK
        string document_number
        string status
    }
    document_requirement_templates {
        bigint id PK
        string name
        string type
    }
    document_requirements {
        bigint id PK
        bigint client_id FK
        bigint template_id FK "nullable"
        bigint accounting_period_id FK "nullable"
        bigint created_by FK
        string scope "nullable"
    }
    requirement_documents {
        bigint id PK
        bigint requirement_id FK
        bigint document_id FK
        bigint linked_by FK
    }
    document_follow_ups {
        bigint id PK
        bigint requirement_id FK
        bigint assigned_to FK "nullable"
        bigint created_by FK
        string status
    }
    account_templates {
        bigint id PK
        string name
        int version
    }
    account_template_items {
        bigint id PK
        bigint account_template_id FK
        string code
        string classification
    }
    accounts {
        bigint id PK
        bigint client_id FK
        bigint account_template_item_id FK "nullable"
        string code
        string classification
    }
    accounting_years {
        bigint id PK
        bigint client_id FK
        date starts_on
        date ends_on
    }
    accounting_periods {
        bigint id PK
        bigint client_id FK
        bigint accounting_year_id FK
        bigint closed_by FK "nullable"
        string status
    }
    ledger_entries {
        bigint id PK
        bigint client_id FK
        bigint accounting_period_id FK "nullable"
        bigint created_by FK
        bigint reviewed_by FK "nullable"
        bigint posted_by FK "nullable"
        string status
    }
    ledger_items {
        bigint id PK
        bigint ledger_entry_id FK
        bigint client_id FK "nullable"
        bigint account_id FK "nullable"
        decimal debit
        decimal credit
    }
    journal_documents {
        bigint id PK
        bigint ledger_entry_id FK
        bigint client_id FK
        bigint document_id FK
        bigint attached_by FK
        datetime detached_at "nullable"
    }
    vouchers {
        bigint id PK
        bigint ledger_entry_id FK "unique"
        bigint client_id FK
        bigint cash_account_id FK "nullable"
        string type
        string reference
    }
    compliance_records {
        bigint id PK
        bigint client_id FK
        bigint assigned_to FK "nullable"
        bigint created_by FK
        date due_date
        date submission_deadline "nullable"
        string status
    }
    compliance_follow_ups {
        bigint id PK
        bigint compliance_record_id FK
        bigint assigned_to FK "nullable"
        bigint created_by FK
        string status
    }
    invoices {
        bigint id PK
        bigint client_id FK
        bigint created_by FK
        string invoice_number
        string status
    }
    invoice_items {
        bigint id PK
        bigint invoice_id FK
        decimal quantity
        decimal unit_price
    }
    payments {
        bigint id PK
        bigint invoice_id FK
        bigint recorded_by FK
        decimal amount
    }
    knowledge_articles {
        bigint id PK
        bigint author_id FK
        string title
        string status
    }
    notices {
        bigint id PK
        bigint client_id FK "nullable"
        bigint created_by FK
        string status
    }
    settings {
        bigint id PK
        string firm_name
    }
    notifications {
        uuid id PK
        string notifiable_type "logical"
        bigint notifiable_id "logical"
        datetime read_at "nullable"
    }
    notification_events {
        bigint id PK
        bigint user_id FK
        string event_key
    }
    audit_logs {
        bigint id PK
        bigint user_id FK "nullable"
        bigint client_id FK "nullable"
        bigint record_id "logical"
        string module
        string action
    }
    password_reset_tokens {
        string email PK
        string token
    }
    sessions {
        string id PK
        bigint user_id "nullable logical"
        string payload
    }
    cache {
        string key PK
        mediumtext value
    }
    cache_locks {
        string key PK
        string owner
    }
    jobs {
        bigint id PK
        string queue
    }
    job_batches {
        string id PK
        string name
    }
    failed_jobs {
        bigint id PK
        string uuid
    }
    migrations {
        int id PK
        string migration
        int batch
    }

