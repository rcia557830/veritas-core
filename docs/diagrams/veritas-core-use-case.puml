@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman
skinparam usecaseBackgroundColor #D1D3D6
skinparam usecaseBorderColor #AEB2B7
skinparam ArrowColor #AEB2B7

actor "Super Admin" as SA
actor Owner as O
actor "Office Manager" as OM
actor Bookkeeper as BK

rectangle "VERITAS CORE V2" {
  usecase "Manage employee accounts\nand role assignments" as Users
  usecase "Configure workspace" as Settings
  usecase "View system activity\nand security logs" as Security
  usecase "Maintain client records" as Clients
  usecase "Complete client onboarding" as Onboard
  usecase "Upload and access documents" as Documents
  usecase "Manage document requirements\nand validate documents" as Validate
  usecase "Manage client accounts\nand accounting periods" as Accounts
  usecase "Manage account templates\nand initialize client accounts" as Templates
  usecase "Prepare and submit\njournals and vouchers" as Prepare
  usecase "Review and post journals" as Review
  usecase "View ledger and financial audit trail;\ngenerate reports" as Reports
  usecase "Monitor compliance\nand record follow-ups" as Compliance
  usecase "Manage billing\nand record payments" as Billing
  usecase "Read and draft\nKnowledge Base content" as Knowledge
  usecase "Publish Knowledge Base content\nand manage notices" as Publish
}

SA -- Users
SA -- Settings
SA -- Security

O -- Clients
O -- Onboard
O -- Documents
O -- Validate
O -- Accounts
O -- Templates
O -- Prepare
O -- Review
O -- Reports
O -- Compliance
O -- Billing
O -- Knowledge
O -- Publish

OM -- Clients
OM -- Onboard
OM -- Documents
OM -- Validate
OM -- Accounts
OM -- Review
OM -- Reports
OM -- Compliance
OM -- Billing
OM -- Knowledge
OM -- Publish

BK -- Clients
BK -- Documents
BK -- Prepare
BK -- Reports
BK -- Compliance
BK -- Billing
BK -- Knowledge

legend bottom
  Essential user goals; related actions are grouped.
  All actions require an authenticated, active user and appropriate permissions.
  Bookkeeper access is limited by assigned clients and record ownership/state.
  Review/posting requires a different user from the journal creator.
  Posting additionally requires the installed bookkeeping.post grant.
endlegend
@enduml
