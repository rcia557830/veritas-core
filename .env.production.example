# ---------------------------------------------------------------------------
# VERITAS CORE — production configuration template (sanitized, no secrets).
# Copy to `.env` on the production host and fill in every placeholder.
# NEVER commit a filled `.env` (it is git-ignored).
# ---------------------------------------------------------------------------

APP_NAME="VERITAS CORE"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://veritas.example.com
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Generate with: php artisan key:generate  (keep this value secret and back it up)
APP_KEY=

# Use "cache" (requires a shared cache store) to control maintenance mode
# across multiple web workers.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Bcrypt cost for production password hashing.
BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
# Days retained by the "daily" log channel.
LOG_DAILY_DAYS=30

# --- Database (use a dedicated, least-privilege account; TLS where available) -
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=veritas_core_db
DB_USERNAME=veritas_app
DB_PASSWORD=

# --- Sessions / cookies -------------------------------------------------------
# Store sessions in the database so multiple web workers share state.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies are HTTPS-only and inaccessible to JavaScript in production.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# --- Cache / queue -------------------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Mail (configure a real provider before go-live) --------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@veritas.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Trusted proxies -----------------------------------------------------------
# If the app sits behind nginx/Apache/Cloudflare/Load balancer, list proxy IPs
# (comma-separated) so Laravel correctly detects HTTPS and client IPs. Leaving
# the default "*" trusts only when you fully control the network edge; otherwise
# specify exact proxy addresses/CIDRs.
# TRUSTED_PROXIES=

# --- Backup tooling (paths to the MySQL client binaries if not on PATH) --------
# VERITAS_MYSQLDUMP_BIN=
# VERITAS_MYSQL_BIN=
